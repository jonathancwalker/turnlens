{
  "manifest_version": 3,
  "name": "Conversation Lens UX Prototype",
  "version": "0.1.0",
  "description": "A local prototype of a push-aside conversation timeline.",
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
