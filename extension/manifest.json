{
  "manifest_version": 3,
  "name": "Conversation Lens UX Prototype",
  "version": "0.5.2",
  "key": "",
  "description": "A local prototype of a conversation timeline in Chrome's side panel.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Conversation Lens", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "web_accessible_resources": [
    { "resources": ["icons/icon32.png"], "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "http://localhost/*", "http://127.0.0.1/*"] },
    { "resources": ["live-chatgpt.mjs"], "matches": ["https://chatgpt.com/*", "http://127.0.0.1/*", "http://localhost/*"] }
  ],
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
